# ThinkArq AI Chatbot Environment Variables

# Choose your AI provider (optional, high-accuracy built-in RAG fallback works out-of-the-box):
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Server-only Cal.com API settings for in-chat booking. Never use NEXT_PUBLIC_ for the API key.
CAL_API_KEY=your_calcom_api_key_here
CAL_USERNAME=thinkarq
CAL_EVENT_TYPE_SLUG=30min
CAL_TIME_ZONE=Asia/Kolkata

# Crawler Ingestion Secret Key for /app/api/ingest (optional):
INGESTION_SECRET=thinkarq-secure-ingest-key
